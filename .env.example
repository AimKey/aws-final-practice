# Danh sách biến app cần. Giá trị thật nằm trong GitHub secret ENV_FILE (dán nguyên nội dung file này, điền giá trị thật).
# Chạy local: cp .env.example .env rồi điền giá trị.
# DB: endpoint RDS
DATABASE_URL=postgresql://USER:PASSWORD@your-db.xxxx.ap-southeast-1.rds.amazonaws.com:5432/postgres

# S3. Trên EC2 app lấy quyền từ IAM role gắn vào instance -> KHÔNG cần access key.
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=your-bucket-name
# Chỉ khi chạy local (máy không có IAM role) mới thêm 2 dòng này vào .env, đừng đưa vào ENV_FILE:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
